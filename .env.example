# Copy to .env.local and fill in. For local dev, `npm run db:start` prints the Supabase values.

# --- Supabase (public: safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Show "Continue with Google" only once Google OAuth is configured in Supabase (see README).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Supabase "secret" key (or legacy service_role key). Bypasses RLS — server use only.
SUPABASE_SECRET_KEY=sb_secret_...
# Comma-separated auth user ids of the owner(s): only they can reset other admins' passwords or
# demote admins, and no one can do that to them. Optional.
OWNER_USER_IDS=
# Salts the daily puzzle seed. Generate with: openssl rand -hex 32
# Changing it changes every not-yet-generated puzzle (already-stored puzzles are unaffected).
PUZZLE_SEED_SECRET=
