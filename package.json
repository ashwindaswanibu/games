{
  "name": "games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/server/database.types.generated.ts",
    "test:db": "node --env-file=.env.local scripts/db-smoke.mts",
    "test:e2e": "tsx --conditions=react-server --env-file=.env.local scripts/e2e/movies.mts",
    "content:fixtures": "tsx --conditions=react-server --env-file=.env.local scripts/content/fixtures.mts",
    "content:movies:catalog": "tsx --conditions=react-server --env-file=.env.local scripts/content/movies/catalog.mts",
    "content:movies:degrees": "tsx --conditions=react-server --env-file=.env.local scripts/content/movies/degrees.mts",
    "content:movies:stills": "tsx --conditions=react-server --env-file=.env.local scripts/content/movies/stills.mts",
    "content:movies:frame-by-frame": "tsx --conditions=react-server --env-file=.env.local scripts/content/movies/frame-by-frame.mts",
    "content:movies:color-grade": "tsx --conditions=react-server --env-file=.env.local scripts/content/movies/color-grade.mts",
    "content:movies:barcodes": "tsx --conditions=react-server --env-file=.env.local scripts/content/movies/barcodes.mts",
    "content:movies:fixtures": "npm run content:fixtures -- --game degrees --game frame-by-frame --game color-grade --game color-barcode"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "puppeteer-core": "^25.12.0",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  }
}
