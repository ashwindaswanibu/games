/**
 * Embedded starter catalog for the Degrees DEV FIXTURE generator (`./degrees.mts`), used only when
 * the local catalog has no credits yet (the Wikidata import hasn't run). Not a generator: the
 * leading underscore keeps the fixtures runner from loading it as one.
 *
 * Real films and their cast, taken from Wikidata (CC0) on 2026-10-06 with each entity's id, so the
 * catalog importer, which upserts on `wikidata_id`, later merges these rows instead of duplicating
 * them. Cast lists keep Wikidata's cast members (P161) with at least 20 sitelinks, in Wikidata's
 * statement order; that order isn't billing, so credits are stored without one. `sitelinks` is the
 * entity's sitelink count, the catalog's popularity measure.
 */

export interface SeedFilm {
  wikidataId: string;
  title: string;
  year: number;
  imdbId: string | null;
  sitelinks: number;
  genres: readonly string[];
  directors: readonly string[];
  /** Wikidata ids of cast members, all present in SEED_PEOPLE. */
  cast: readonly string[];
}

export interface SeedPerson {
  wikidataId: string;
  name: string;
  sitelinks: number;
}

