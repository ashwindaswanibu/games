# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Movie catalog build cache (content:movies:catalog): IMDb's datasets (personal, non-commercial use
# only), Wikidata query results, snapshots and id baselines. Large and regenerable; never commit.
/content/movies/catalog-cache/

# TMDB stills cache (content:movies:stills). Copyrighted images licensed for display only; never commit.
/content/movies/stills/

# Intermediate review screenshots/frames from design iterations (regenerable; keep the repo lean)
/design/home/shots/
/design/home/frames/

# Supabase CLI link state (project ref, pooler URL)
/supabase/.temp/

# Rendered Fade to Color levels exported for review (barcode-levels --dry-run --out).
# They reveal a puzzle's answer and every locked level, so they never go in git.
/design/barcode-tests/*/levels/
